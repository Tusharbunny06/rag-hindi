# Copy this file to .env and fill in ONE key (optional). Without any key the local model is used.
# .env is listed in .gitignore, so keys are never committed.

GROQ_API_KEY=
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Optional settings (defaults shown)
# RAG_LLM=auto            # auto | groq | gemini | openai | ollama | anthropic | hf | extractive
# RAG_LLM_MODEL=          # override the backend's default model
# RAG_TOP_K=4
# RAG_QUERY_INT8=0        # 1 = int8 query encoder: ~4x faster retrieval on CPU, see README
